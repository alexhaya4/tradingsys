# Supervision for the stack, so it survives a reboot without anyone logging in.
#
# Installed by deploy/provision/bootstrap.sh, which substitutes the paths. Do not edit
# the installed copy at /etc/systemd/system: edit this file and re-run bootstrap, or the
# host stops being reproducible from the repository, which is the whole point.

[Unit]
Description=tradingsys market data stack
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

# The correctness property this line carries: if the block storage volume is not
# mounted, this unit does not start. Without it, Postgres would start against an empty
# directory on the root disk and begin recording into a database that is not the one
# holding our history, and nothing would report an error. A refusal to start is loud;
# writing to the wrong disk is not.
RequiresMountsFor=__DATA_ROOT__

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__REPO_ROOT__
User=__SERVICE_USER__
Group=__SERVICE_USER__

Environment=TRADINGSYS_DATA_ROOT=__DATA_ROOT__
EnvironmentFile=__REPO_ROOT__/.env

# --wait, not bare up -d. Without it this command returns zero once containers are
# created, so the unit reports active (exited) whether or not anything works. On
# 2026-08-19 the app crash-looped for four hours behind exactly that, because creating a
# container and running a process are different facts and only the first was asserted.
#
# --wait blocks until every service with a healthcheck reports healthy, and the app's
# healthcheck probes /ready, so a start that succeeds means the process can serve rather
# than that a socket is open.
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f deploy/provision/docker-compose.prod.yml up -d --build --wait --wait-timeout 300
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f deploy/provision/docker-compose.prod.yml down

# A build on 2 vCPU can take several minutes on a cold cache, and --wait then adds the
# health settling time on top.
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
