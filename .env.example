# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Only secrets and machine specific values belong here. Everything else lives in the
# TOML files under config/, which are committed.
#
# Naming: TRADINGSYS_ prefix, double underscore between nested levels. The dotted path
# database.password becomes TRADINGSYS_DATABASE__PASSWORD.

# --- required -------------------------------------------------------------------

# Used both by the postgres container and by the application.
POSTGRES_PASSWORD=change-me
TRADINGSYS_DATABASE__PASSWORD=change-me

GRAFANA_PASSWORD=change-me

# --- optional -------------------------------------------------------------------

# development, test, staging, or production. Selects config/{environment}.toml.
#TRADINGSYS_APP__ENVIRONMENT=development

#TRADINGSYS_REDIS__PASSWORD=

# Forex venue. The account id is not secret but is deployment specific; the token is a
# secret. Enabling the venue without both aborts startup.
#TRADINGSYS_VENUES__FOREX__ENABLED=true
#TRADINGSYS_VENUES__FOREX__ACCOUNT_ID=
#TRADINGSYS_VENUES__FOREX__API_TOKEN=

# Crypto venue credentials, keyed by the name used in the TOML config.
#TRADINGSYS_VENUES__CRYPTO__BINANCE__API_KEY=
#TRADINGSYS_VENUES__CRYPTO__BINANCE__API_SECRET=

# Directory a secret manager projects one file per secret into. File names follow the
# same convention as the variables above, with or without the prefix.
#TRADINGSYS_SECRETS_DIR=/run/secrets
