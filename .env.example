# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Only secrets and machine specific values belong here. Everything else lives in the
# TOML files under config/, which are committed.
#
# WHO READS THIS FILE: docker compose, automatically, and scripts/verify.sh, which
# sources it. The application does not, in any environment. It accepts secrets only
# from the environment or from the secrets directory, never from a file it parses, and
# that rule has no exceptions so that it cannot be wrong about which environment it is
# running in.
#
# So to run anything on the host outside those two entry points, export this file
# first:
#
#     set -a; . ./.env; set +a
#
# Naming: TRADINGSYS_ prefix, double underscore between nested levels. The dotted path
# database.password becomes TRADINGSYS_DATABASE__PASSWORD.

# --- required -------------------------------------------------------------------

# Used both by the postgres container and by the application.
POSTGRES_PASSWORD=change-me
TRADINGSYS_DATABASE__PASSWORD=change-me

GRAFANA_PASSWORD=change-me

# --- alerting ------------------------------------------------------------------
#
# Required on a deployed host. bootstrap.sh refuses to continue without them, because a
# recorder that fails without telling anyone is the configuration this project has
# already decided not to operate.
#
# These are read by systemd units and shell scripts, never by the application, which is
# why they are flat names rather than TRADINGSYS_SECTION__FIELD. The alerter has to be
# able to report that the application is dead, so it cannot live inside it.
#
# Token and chat id come from BotFather. The chat id is the destination, not the bot.
TRADINGSYS_ALERT_TELEGRAM_TOKEN=change-me
TRADINGSYS_ALERT_TELEGRAM_CHAT_ID=change-me

# The ping URL of an external dead man switch, pinged by the canary on every successful
# delivery. When the ping stops arriving the switch alerts by a channel that is not this
# host and not Telegram, which is the point: a detector that shares either cannot report
# that one has broken. Treat as a secret. Anyone holding it can suppress the alert by
# pinging it themselves, which is a suppression risk rather than a data risk.
TRADINGSYS_ALERT_DEADMAN_URL=change-me

# --- optional -------------------------------------------------------------------

# How long a persisting condition waits before it repeats, in minutes. Default 30, which
# is 8 messages across a four hour outage. Lower it and a long outage mutes the channel;
# raise it and a real one reads as resolved.
#TRADINGSYS_ALERT_REPEAT_MINUTES=30

# Where the alerter keeps which conditions are firing and the canary sequence. Default
# /var/lib/tradingsys, created by bootstrap.sh. Losing it costs suppression and recovery
# messages, not alerts.
#TRADINGSYS_ALERT_STATE_DIR=/var/lib/tradingsys

# How many journal lines a failed unit's alert carries. Default 30.
#TRADINGSYS_ALERT_JOURNAL_LINES=30

# The Telegram API base. Default https://api.telegram.org. It is a variable so the
# delivery path can be exercised against a server that answers, which is the only way to
# test the last hop of an alerter without sending real messages.
#TRADINGSYS_ALERT_TELEGRAM_API=https://api.telegram.org

# development, test, staging, or production. Selects config/{environment}.toml.
#TRADINGSYS_APP__ENVIRONMENT=development

#TRADINGSYS_REDIS__PASSWORD=

# Forex venue: cTrader Open API. The account id is deployment specific but not secret;
# the other four are secrets. Enabling the venue without all five aborts startup, and
# the error names each one that is missing.
#
# The access token expires after about 30 days and is renewed with the refresh token.
# When the venue rotates the refresh token, the new value must be written back here, or
# the next restart cannot authenticate and the account needs reauthorising by hand.
#TRADINGSYS_VENUES__FOREX__ENABLED=true
#TRADINGSYS_VENUES__FOREX__ACCOUNT_ID=
#TRADINGSYS_VENUES__FOREX__CLIENT_ID=
#TRADINGSYS_VENUES__FOREX__CLIENT_SECRET=
#TRADINGSYS_VENUES__FOREX__ACCESS_TOKEN=
#TRADINGSYS_VENUES__FOREX__REFRESH_TOKEN=

# Crypto venue credentials, keyed by the name used in the TOML config.
#TRADINGSYS_VENUES__CRYPTO__BYBIT__API_KEY=
#TRADINGSYS_VENUES__CRYPTO__BYBIT__API_SECRET=

# Directory a secret manager projects one file per secret into. File names follow the
# same convention as the variables above, with or without the prefix.
#TRADINGSYS_SECRETS_DIR=/run/secrets
